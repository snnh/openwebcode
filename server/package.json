{
  "name": "@openwebcode/server",
  "version": "1.10.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contracts-check": "tsx ../scripts/contracts-check/check.ts && tsc --noEmit -p ../scripts/contracts-check/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.12.3",
    "undici": "^8.10.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  }
}
