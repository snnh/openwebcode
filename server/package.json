{
  "name": "@openwebcode/server",
  "version": "1.12.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contracts-check": "tsx ../scripts/contracts-check/check.ts && tsc --noEmit -p ../scripts/contracts-check/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "fastify": "^5.6.2",
    "undici": "^8.11.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
