{
  "name": "@openwebcode/server",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contracts-check": "tsx ../scripts/contracts-check/check.ts && tsc --noEmit -p ../scripts/contracts-check/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.6.2",
    "undici": "^8.9.0",
    "ws": "8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "knip": "^6.44.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
