<?xml version="1.0" encoding="UTF-8"?>
<!--
  CPack WIX inserts these fragments into the generated source.  The component
  id below is intentionally tied to bin/owc.cmd and was verified from CPack's
  generated files.wxs for this install layout:

    <Component Id="CM_CP_bin.owc.cmd" ...>

  Keep the two IDs in sync if the staging/install layout changes.
-->
<CPackWiXPatch xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <CPackWiXFragment Id="#PRODUCT">
    <!-- These public properties cross the UI/elevated execute boundary.  A
         registry search restores a prior selection for repair/major upgrade;
         the Value attribute supplies the first-install default. -->
    <Property Id="OWC_CREATE_DESKTOP_SHORTCUT" Value="1" Secure="yes">
      <RegistrySearch Id="FindOwcDesktopShortcutPreference"
                      Root="HKCU"
                      Key="Software\OpenWebCode\Installer"
                      Name="CreateDesktopShortcut"
                      Type="raw" />
    </Property>
    <Property Id="OWC_ADD_TO_PATH" Value="1" Secure="yes">
      <RegistrySearch Id="FindOwcPathPreference"
                      Root="HKCU"
                      Key="Software\OpenWebCode\Installer"
                      Name="AddToPath"
                      Type="raw" />
    </Property>

    <!-- Default is deliberately non-destructive.  PURGE_DATA is a public MSI
         property so a user can opt in with: msiexec /x package.msi PURGE_DATA=1 -->
    <Property Id="PURGE_DATA" Value="0" />
    <!-- Keep the deletion root private (mixed case): PURGE_DATA is the only
         command-line opt-in, and must not also allow redirecting the root.
         WiX runs its table action on every install/uninstall, so its default
         is a reserved inert path, never the application's data directory. -->
    <Property Id="OwcDefaultDataDir"
              Value="%USERPROFILE%\OpenWebCode--PurgeDisabled--7F3A2C1E-9B4D-4E6F-A1C8-2D5B7E9F0C3A" />
    <CustomAction Id="SetOwcDefaultDataDir"
                  Property="OwcDefaultDataDir"
                  Value="%USERPROFILE%\openwebcode" />
    <!-- Legacy default location (pre-1.0 installs kept data under
         LOCALAPPDATA); purged alongside the new default on opt-in. -->
    <Property Id="OwcLegacyDataDir"
              Value="%LOCALAPPDATA%\OpenWebCode--PurgeDisabled--8A4B3D2F-1C5E-4F7B-B2D9-3E6C8F1A4D7B" />
    <CustomAction Id="SetOwcLegacyDataDir"
                  Property="OwcLegacyDataDir"
                  Value="%LOCALAPPDATA%\openwebcode" />
    <!-- WiX v3's RemoveFolderEx has no Condition attribute and its supplied
         custom action is sequenced by the Util extension.  Replacing the
         inert path only immediately before that action makes cleanup opt-in
         without creating a second, conflicting sequence entry. -->
    <InstallExecuteSequence>
      <Custom Action="SetOwcDefaultDataDir" Before="WixRemoveFoldersEx">NOT UPGRADINGPRODUCTCODE AND PURGE_DATA=1 AND REMOVE=&quot;ALL&quot;</Custom>
      <Custom Action="SetOwcLegacyDataDir" Before="WixRemoveFoldersEx">NOT UPGRADINGPRODUCTCODE AND PURGE_DATA=1 AND REMOVE=&quot;ALL&quot;</Custom>
    </InstallExecuteSequence>
  </CPackWiXFragment>

  <CPackWiXFragment Id="CM_CP_bin.owc.cmd">
    <!-- The conditional property assignment above means this affects only
         opt-in full uninstalls of the launcher's default USERPROFILE data
         location and the legacy LOCALAPPDATA location; custom OWC_DATA_DIR
         values and workspace .owc directories are intentionally outside
         this action. -->
    <util:RemoveFolderEx Id="PurgeOpenWebCodeDefaultData"
                         Property="OwcDefaultDataDir"
                         On="uninstall" />
    <util:RemoveFolderEx Id="PurgeOpenWebCodeLegacyData"
                         Property="OwcLegacyDataDir"
                         On="uninstall" />
  </CPackWiXFragment>

  <!-- Components declared in packaging/openwebcode-ui.wxs participate in
       CPack's root feature.  They are separate from owc.cmd so unchecking
       PATH never suppresses the launcher itself. -->
  <CPackWiXFragment Id="#PRODUCTFEATURE">
    <ComponentRef Id="OpenWebCodeDesktopShortcut" />
    <ComponentRef Id="OpenWebCodeUserPath" />
    <ComponentRef Id="OpenWebCodeShellIntegrationState" />
  </CPackWiXFragment>
</CPackWiXPatch>
